`ifndef LA32_ARITHMETIC_OPS_VH
`define LA32_ARITHMETIC_OPS_VH

// Shared operation encodings for contest_arithmetic_unit and its callers.
`define LA32_ARITH_OP_UDIV  3'd0
`define LA32_ARITH_OP_SDIV  3'd1
`define LA32_ARITH_OP_UMOD  3'd2
`define LA32_ARITH_OP_SMOD  3'd3
`define LA32_ARITH_OP_ISQRT 3'd4
`define LA32_ARITH_OP_GCD   3'd5

`endif
